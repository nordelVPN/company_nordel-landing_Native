<header class="site-header">
  <div class="container site-header__inner">
    <a class="logo" href="./index.html" aria-label="Nordel home">{{> logo}}</a>
    <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>☰</button>
    <nav class="nav" id="main-nav" aria-label="Main navigation">
      <a href="./index.html#why-nordel">Why Nordel</a><a href="./index.html#app">The app</a><a href="./index.html#pricing">Get started</a>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Dark theme" aria-pressed="false">☉</button>
      <label class="language"><span class="sr-only">Language</span><select aria-label="Language"><option value="en">EN</option></select></label>
      <a class="header-explore" href="./index.html#app">Explore the app</a>
      {{#if landing}}<button class="button" type="button" data-wishlist-open>Discover Nordel <span aria-hidden="true">↗</span></button>{{else}}<a class="button" href="./index.html#pricing">Discover Nordel ↗</a>{{/if}}
    </div>
  </div>
</header>
