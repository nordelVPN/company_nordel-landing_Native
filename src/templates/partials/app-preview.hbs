<section class="app-section container" id="app" aria-labelledby="app-title">
  <div class="app-copy">
    <p class="eyebrow" data-i18n="app.eyebrow">{{app.eyebrow}}</p>
    <h2 id="app-title"><span data-i18n="app.title">{{app.title}}</span><br><span data-i18n="app.titleEnd">{{app.titleEnd}}</span></h2>
    <p class="lead" data-i18n="app.description">{{app.description}}</p>
    <ol class="steps">{{#each app.steps}}<li data-i18n="app.steps.{{@index}}">{{this}}</li>{{/each}}</ol>
    <p class="app-hint" data-i18n="app.hint">{{app.hint}}</p>
  </div>
  <div class="phone" data-app-preview>
    <div class="phone-status" aria-hidden="true"><span>9:41</span><span>● ▰</span></div>
    <div class="phone-header"><span class="logo">{{> logo}}</span><button type="button" data-demo-info aria-label="Preview menu" data-i18n-aria-label="app.menu">☰</button></div>
    <div class="phone-landscape">{{> mountains phone=true}}</div>
    <div class="phone-content">
      <p class="connection-status" data-connection-status aria-live="polite" data-i18n="app.status">{{app.status}}</p>
      <h3 data-connection-heading data-i18n="app.heading">{{app.heading}}</h3>
      <p class="phone-note" data-connection-note data-i18n="app.note">{{app.note}}</p>
      <button class="connect-button" type="button" data-connect aria-pressed="false"
        data-on="{{app.disconnect}}" data-off="{{app.connect}}"
        data-status-on="{{app.connectedStatus}}" data-status-off="{{app.status}}"
        data-heading-on="{{app.connectedHeading}}" data-heading-off="{{app.heading}}"
        data-note-on="{{app.connectedNote}}" data-note-off="{{app.note}}" data-i18n="app.connect">{{app.connect}}</button>
      <button class="location" type="button" data-demo-info><span aria-hidden="true">◉</span><span><small data-i18n="app.locationLabel">{{app.locationLabel}}</small><strong data-i18n="app.location">{{app.location}}</strong></span><span aria-hidden="true">⌄</span></button>
    </div>
    <nav class="phone-tabs" aria-label="App preview" data-i18n-aria-label="app.navigation">{{#each app.tabs}}<button type="button" data-demo-info data-i18n="app.tabs.{{@index}}">{{this}}</button>{{/each}}</nav>
    <p class="demo-info" data-demo-notice hidden role="status" data-i18n="app.demoNotice">{{app.demoNotice}}</p>
  </div>
  <p class="section-caption" data-i18n="app.caption">{{app.caption}}</p>
</section>
