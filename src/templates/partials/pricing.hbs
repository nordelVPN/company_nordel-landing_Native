<section class="pricing container" id="pricing" aria-labelledby="pricing-title">
  <p class="eyebrow" data-i18n="pricing.eyebrow">{{pricing.eyebrow}}</p><h2 id="pricing-title" data-i18n="pricing.title">{{pricing.title}}</h2><p class="lead" data-i18n="pricing.description">{{pricing.description}}</p>
  <div class="plans">{{#each pricing.plans}}{{> plan-card}}{{/each}}</div>
  <p class="pricing-note" data-i18n="pricing.note">{{pricing.note}}</p>
</section>
