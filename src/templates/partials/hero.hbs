<section class="hero container" id="why-nordel" aria-labelledby="hero-title">
  {{> mountains}}
  <div class="hero__content">
    <p class="eyebrow" data-i18n="hero.eyebrow">{{hero.eyebrow}}</p>
    <h1 id="hero-title"><span data-i18n="hero.title">{{hero.title}}</span><br><span data-i18n="hero.accent">{{hero.accent}}</span></h1>
    <p class="lead" data-i18n="hero.description">{{hero.description}}</p>
    <a class="button" href="#app"><span data-i18n="hero.button">{{hero.button}}</span> <span aria-hidden="true">↗</span></a>
    <p class="hero__note" data-i18n="hero.note">{{hero.note}}</p>
  </div>
  <p class="section-caption" data-i18n="hero.caption">{{hero.caption}}</p>
</section>
<div class="features container">
  {{#each features}}<article class="feature"><span class="feature__icon" aria-hidden="true">{{icon}}</span><div><h2 data-i18n="features.{{@index}}.title">{{title}}</h2><p data-i18n="features.{{@index}}.description">{{description}}</p></div></article>{{/each}}
</div>
